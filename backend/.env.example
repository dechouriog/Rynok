# --- Base de datos ---
# En hosting basta con DATABASE_URL (tiene prioridad sobre DB_*).
# DB_SSL=true para proveedores que exigen SSL (Neon, Supabase, Render externo).
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5433
DB_USER=rynok
DB_PASSWORD=rynok
DB_NAME=rynok
# true: TypeORM crea/actualiza las tablas solo (MVP). false: usar migraciones.
DB_SYNCHRONIZE=true

# --- API ---
PORT=3001
# production: exige JWT_SECRET y verificación on-chain del escrow
NODE_ENV=development
# Obligatorio en producción. Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Orígenes permitidos por CORS, separados por coma (p. ej. la URL de Vercel)
CORS_ORIGINS=http://localhost:3000
# Carpeta para las imágenes subidas (opcional, por defecto backend/uploads)
UPLOAD_DIR=

# --- Escrow (verificación on-chain) ---
# Local: http://127.0.0.1:8545 (npx hardhat node) · Sepolia: URL de Alchemy/Infura.
# Sin ESCROW_RPC_URL: en desarrollo no se verifica; en producción se rechazan las operaciones.
ESCROW_RPC_URL=
ESCROW_CONTRACT_ADDRESS=0x049BBA8708b71E33f649Bae0E2F127F805ca9Ca9

# --- Seed (opcional) ---
# Wallet dueña de las propiedades demo (por defecto la cuenta #0 pública de Hardhat)
DEMO_SELLER_ADDRESS=
# Multiplica los precios demo (0.001 en Sepolia, donde los faucets dan poco ETH)
DEMO_PRICE_SCALE=1
