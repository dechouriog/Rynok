# En hosting basta con DATABASE_URL (tiene prioridad sobre DB_*).
# DB_SSL=true para proveedores que exigen SSL (Neon, Supabase, Render externo).
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5433
DB_USER=rynok
DB_PASSWORD=rynok
DB_NAME=rynok
PORT=3001
JWT_SECRET=cambia-esto-en-produccion
# Carpeta para las imágenes subidas (opcional, por defecto backend/uploads)
UPLOAD_DIR=

# Verificación on-chain de las transacciones de escrow (recomendado).
# Sin ESCROW_RPC_URL el backend confía en los hashes que envía el frontend.
# Local: http://127.0.0.1:8545 (npx hardhat node) · Sepolia: URL de Alchemy/Infura
ESCROW_RPC_URL=
ESCROW_CONTRACT_ADDRESS=
