# URL pública de la API (la usa el navegador). En Vercel: la URL de Render.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Opcional: URL de la API vista desde el servidor de Next (Docker)
API_URL_INTERNAL=

# Red del contrato: 11155111 = Sepolia, 31337 = nodo local de Hardhat
NEXT_PUBLIC_CHAIN_ID=11155111
# Dirección del contrato Escrow desplegado (Sepolia: la del README)
NEXT_PUBLIC_ESCROW_ADDRESS=0x049BBA8708b71E33f649Bae0E2F127F805ca9Ca9
# Opcional: RPC para leer el contrato sin MetaMask (por defecto, uno público de la red)
NEXT_PUBLIC_RPC_URL=

# URL pública del sitio (Open Graph). En Vercel: la URL del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
